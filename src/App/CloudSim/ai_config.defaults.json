{
  "hardware_profile": "vram_8gb",
  "mesh_create_defaults": {
    "box": { "length": 100, "width": 100, "height": 100 },
    "cylinder": { "radius": 50, "height": 100 },
    "cone": { "radius": 50, "height": 100 },
    "sphere": { "radius": 50 }
  },
  "parser_priority": ["rules", "local", "remote"],
  "enable_rules": true,
  "remote_llm": { "enabled": false },
  "router": {
    "mode": "rules_score",
    "base_url": "http://127.0.0.1:11434/v1",
    "local_model": "qwen2.5:3b",
    "min_score": 2
  },
  "agent": {
    "max_steps": 8,
    "auto_execute_low_risk": false,
    "require_keyword_hit": true,
    "enable_trace": true,
    "enable_plan": true,
    "plan_max_steps": 8,
    "replan_on_failure": true
  },
  "domains": [
    {
      "id": "mesh.create",
      "enabled": true,
      "base_url": "http://127.0.0.1:11434/v1",
      "model": "qwen2.5:3b",
      "multimodal": false,
      "parser_priority": ["rules", "local"]
    },
    {
      "id": "mesh.compose",
      "enabled": true,
      "base_url": "http://127.0.0.1:11434/v1",
      "model": "qwen2.5:3b",
      "multimodal": false,
      "parser_priority": ["rules", "local"]
    },
    {
      "id": "feature.compose",
      "enabled": true,
      "base_url": "http://127.0.0.1:11434/v1",
      "model": "qwen2.5:3b",
      "multimodal": false,
      "parser_priority": ["rules", "local", "remote"]
    },
    {
      "id": "geometry.recognize",
      "enabled": true,
      "base_url": "http://127.0.0.1:11434/v1",
      "model": "qwen2.5vl:3b",
      "multimodal": true,
      "parser_priority": ["local"],
      "unload_other_models_before_infer": true
    },
    {
      "id": "trajectory.feature",
      "enabled": true,
      "base_url": "http://127.0.0.1:11434/v1",
      "model": "qwen2.5:3b",
      "multimodal": false,
      "parser_priority": ["rules", "local"]
    },
    {
      "id": "pointcloud.ops",
      "enabled": true,
      "base_url": "http://127.0.0.1:11434/v1",
      "model": "qwen2.5:3b",
      "multimodal": false,
      "parser_priority": ["rules", "local"]
    },
    {
      "id": "document.import",
      "enabled": true,
      "base_url": "http://127.0.0.1:11434/v1",
      "model": "qwen2.5:3b",
      "multimodal": false,
      "parser_priority": ["rules", "local"]
    },
    {
      "id": "geometry.ops",
      "enabled": true,
      "base_url": "http://127.0.0.1:11434/v1",
      "model": "qwen2.5:3b",
      "multimodal": false,
      "parser_priority": ["rules", "local"]
    },
    {
      "id": "feature.build",
      "enabled": true,
      "base_url": "http://127.0.0.1:11434/v1",
      "model": "qwen2.5:3b",
      "multimodal": false,
      "parser_priority": ["rules", "local"]
    },
    {
      "id": "design.parts",
      "enabled": true,
      "base_url": "http://127.0.0.1:11434/v1",
      "model": "qwen2.5:3b",
      "multimodal": false,
      "parser_priority": ["rules", "local"]
    },
    {
      "id": "labeling.annot",
      "enabled": true,
      "base_url": "http://127.0.0.1:11434/v1",
