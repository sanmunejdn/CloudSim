# BugTracker 配置（复制为 .env 后修改；.env 已被 gitignore，切勿提交）

# 服务监听
BT_HOST=0.0.0.0
BT_PORT=8500

# 会话有效期（小时）
BT_SESSION_TTL_HOURS=12

# 附件大小上限（MB）
BT_MAX_UPLOAD_MB=50

# 集成接口令牌（git hook / CI 脚本调用 /api/integrations/* 时使用；务必改为长随机串）
BT_INTEGRATION_TOKEN=change-me-to-a-long-random-string

# Agent（MCP/CLI）写操作归属的用户名
BT_AGENT_USERNAME=agent

# 首启 admin 初始密码（可选；不设置则随机生成并打印到控制台一次）
BT_ADMIN_PASSWORD=

# SMTP 通知邮件（可选，TODO：配置真实 SMTP 后启用邮件通道）
BT_SMTP_HOST=
BT_SMTP_PORT=465
BT_SMTP_USER=
BT_SMTP_PASSWORD=
BT_SMTP_FROM=
