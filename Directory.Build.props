<?xml version="1.0" encoding="utf-8"?>

<!-- 统一 CloudSim 各工程输出/链接目录，避免 $(SolutionDir) 为空时找不到 .lib -->

<Project>

  <PropertyGroup>
    <!-- 规范化绝对路径并保留尾斜杠，避免 CL 命令行里 CloudSim\..\bin 抖动 -->
    <CloudSimRepoRoot>$([MSBuild]::EnsureTrailingSlash($([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\'))))</CloudSimRepoRoot>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">

    <CloudSimBinDir>$(CloudSimRepoRoot)bin\x64d\</CloudSimBinDir>

    <CloudSimIntRoot>$(CloudSimRepoRoot)bin\x64dmiddle\</CloudSimIntRoot>

  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'">

    <CloudSimBinDir>$(CloudSimRepoRoot)bin\x64d\</CloudSimBinDir>

    <CloudSimIntRoot>$(CloudSimRepoRoot)bin\x64dmiddle\</CloudSimIntRoot>

  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">

    <CloudSimBinDir>$(CloudSimRepoRoot)bin\x64\</CloudSimBinDir>

    <CloudSimIntRoot>$(CloudSimRepoRoot)bin\x64middle\</CloudSimIntRoot>

  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|Win32'">

    <CloudSimBinDir>$(CloudSimRepoRoot)bin\x64\</CloudSimBinDir>

    <CloudSimIntRoot>$(CloudSimRepoRoot)bin\x64middle\</CloudSimIntRoot>

  </PropertyGroup>

  <!-- Qt 每次 Build 都会 Overwrite IntDir\qt\qt_work.log；该文件新于 DLL 时 VS Fast Up-To-Date 永久失败，表现为 RobotWidget/Widget「无改动仍生成」 -->
  <PropertyGroup>
    <QtLogFilePath Condition="'$(QtLogFilePath)' == ''">$(TEMP)\CloudSim_$(MSBuildProjectName)_$(Configuration)_$(Platform)_qt_work.log</QtLogFilePath>
  </PropertyGroup>

  <ItemDefinitionGroup Condition="'$(Platform)'=='x64'">

    <ClCompile>

      <MultiProcessorCompilation>true</MultiProcessorCompilation>

    </ClCompile>

  </ItemDefinitionGroup>

</Project>

